DATABASE_URL=file:./dev.db

# Admin dashboard account. Created by `npm run db:seed`.
# Change both before seeding any shared or deployed database.
ADMIN_EMAIL=admin@kinetic.com
ADMIN_PASSWORD=admin123
# Secret used to sign admin session tokens. Minimum 32 characters.
# Without it the server falls back to a development constant.
ADMIN_JWT_SECRET=

# Storefront owner address. New Cash on Delivery orders are reported here.
STORE_EMAIL=zakariaqassifi10@gmail.com
# Display name used in the From header.
STORE_NAME=Kinetic Store

# SMTP transport for order notifications. Leave SMTP_HOST/USER/PASS empty to
# run without email — orders still save, and a warning is logged at boot.
# Gmail: enable 2-Step Verification, then create an App Password and use it as
# SMTP_PASS (the account password will not work).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to true for implicit TLS (port 465). Leave unset for STARTTLS on 587.
SMTP_SECURE=false
# Optional: override the From address. Defaults to SMTP_USER.
# SMTP_FROM=

PORT=5000

# Comma-separated list of origins allowed to call the API from a browser, e.g.
# CORS_ORIGINS=https://shop.example.com,https://www.example.com
# Leave unset to allow any origin (fine locally; set it in production).
CORS_ORIGINS=

# Frontend: where the browser sends its API calls (defaults to http://localhost:5000/api)
VITE_API_BASE_URL=http://localhost:5000/api