{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode: the server runs through tsx, which resolves extensionless
       relative specifiers the way a bundler does, so `bundler` is an accurate
       model of the runtime. Node-native ESM would require explicit .js
       extensions on every relative import. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * Type-check the server-side sources too. They previously fell outside every
   * project, which meant backend type errors went unnoticed (tsx strips types
   * without checking them). shared/ is listed because the API and the browser
   * bundle both import from it.
   */
  "include": ["vite.config.ts", "server.ts", "server", "prisma", "shared"]
}
